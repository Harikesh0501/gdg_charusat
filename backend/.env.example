# Backend Configuration
PROJECT_NAME="SkillForge AI Backend"
ENVIRONMENT="development"

# Database Connection (Supabase PostgreSQL or Local SQLite)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:5432/postgres"

# Supabase Authentication
SUPABASE_URL="https://[YOUR-SUPABASE-REF].supabase.co"
SUPABASE_JWT_SECRET="[YOUR-SUPABASE-JWT-SECRET]"

# Groq API Keys & Rotation Fallbacks
GROQ_API_KEY="gsk_[PRIMARY-KEY]"
GROQ_API_KEY_1="gsk_[FALLBACK-KEY-1]"
GROQ_API_KEY_2="gsk_[FALLBACK-KEY-2]"
GROQ_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"

# OpenRouter API Keys & Rotation Fallbacks
OPENROUTER_API_KEY="sk-or-v1-[PRIMARY-KEY]"
OPENROUTER_API_KEY_1="sk-or-v1-[FALLBACK-KEY-1]"
OPENROUTER_API_KEY_2="sk-or-v1-[FALLBACK-KEY-2]"
OPENROUTER_EMBEDDING_MODEL="nvidia/nemotron-3-embed-1b"

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
